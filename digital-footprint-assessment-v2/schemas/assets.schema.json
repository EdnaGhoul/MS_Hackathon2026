{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assets.json \u2014 the photo asset manifest, single source of truth for section 7",
  "type": "object",
  "required": [
    "subject",
    "capture_budget",
    "assets"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "capture_budget": {
      "type": "integer"
    },
    "cdn_pattern": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "candidate_source",
          "page_url",
          "image_url",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^asset-[0-9]{2,}$"
          },
          "candidate_source": {
            "type": "string",
            "enum": [
              "search_images",
              "browser_grid",
              "page_caption"
            ]
          },
          "page_url": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "image_url_best": {
            "type": "string"
          },
          "native_w": {
            "type": "integer"
          },
          "native_h": {
            "type": "integer"
          },
          "host": {
            "type": "string"
          },
          "caption_verbatim": {
            "type": "string"
          },
          "title_attached": {
            "type": "string"
          },
          "title_outdated": {
            "type": "boolean"
          },
          "credit": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "enum": [
              "corporate headshot",
              "event",
              "stage",
              "press",
              "award",
              "other"
            ]
          },
          "descriptive_title": {
            "type": "string"
          },
          "dedupe_group": {
            "type": "string"
          },
          "rank": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "candidate",
              "queued",
              "capturing",
              "captured",
              "verified",
              "shown",
              "duplicate",
              "not_photo",
              "budget_capped",
              "unverifiable",
              "wrong_person",
              "exhausted",
              "budget_exhausted",
              "browser_unavailable",
              "unresolved_address"
            ]
          },
          "reason": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "sidecar": {
            "type": "string"
          },
          "placement_mm": {
            "type": "number"
          },
          "verification": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "matched_against": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "match",
                  "no-match",
                  "unsure"
                ]
              }
            }
          },
          "attempts": {
            "type": "integer"
          },
          "address_unresolved": {
            "type": "boolean"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "found_distinct": {
          "type": "integer"
        },
        "attempted": {
          "type": "integer"
        },
        "verified": {
          "type": "integer"
        },
        "shown": {
          "type": "integer"
        },
        "budget_applied": {
          "type": "boolean"
        }
      }
    }
  }
}