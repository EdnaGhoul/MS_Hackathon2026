{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exec Command Center daily brief (schemaVersion 2)",
  "type": "object",
  "required": ["schemaVersion", "meta", "kpis", "decisions", "calendar", "risks", "risksNote", "inbox", "ledger", "hygiene", "people"],
  "$defs": {
    "status": { "enum": ["red", "amber", "green", "grey"] },
    "evidence": { "enum": ["verified", "inferred", "estimate"] },
    "link": { "type": "object", "required": ["label", "url"], "properties": { "label": {"type": "string"}, "url": {"type": "string"} } },
    "brief": {
      "type": "object",
      "required": ["readTime", "stake", "decisions", "preReads", "questions", "outOfTime", "sources", "generatedAt"],
      "properties": {
        "readTime": { "enum": ["1 min", "30 sec"] },
        "stake": { "type": "object", "required": ["text", "evidence"], "properties": { "text": {"type": "string"}, "evidence": {"$ref": "#/$defs/evidence"} } },
        "decisions": { "type": "array", "items": { "type": "object", "required": ["text", "owner", "deadline"] } },
        "preReads": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["title", "url", "why", "minutes"] } },
        "questions": { "type": "array", "items": { "type": "object", "required": ["rank", "text", "impact"], "properties": { "rank": {"type": "integer", "minimum": 1, "maximum": 5} } } },
        "outOfTime": { "type": "object", "required": ["criticalDecision", "fallback"] },
        "sources": { "type": "array", "items": { "type": "object", "required": ["type", "label", "url"], "properties": { "type": { "enum": ["email", "chat", "transcript", "file", "calendar"] } } } },
        "generatedAt": { "type": "string" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "meta": { "type": "object", "required": ["date", "dayLabel", "generatedAt", "owner", "governingAnswer", "evidenceNote", "updateMechanism"] },
    "kpis": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["id", "label", "value", "unit", "status", "threshold", "fires", "decision", "trend", "evidence"], "properties": { "status": {"$ref": "#/$defs/status"}, "evidence": {"$ref": "#/$defs/evidence"} } } },
    "decisions": { "type": "array", "items": { "type": "object", "required": ["id", "status", "evidence", "title", "situation", "complication", "whyNow", "ifNothingChanges", "verb", "recommendation", "ask", "links"], "properties": { "status": {"$ref": "#/$defs/status"}, "evidence": {"$ref": "#/$defs/evidence"}, "links": { "type": "array", "items": {"$ref": "#/$defs/link"} } } } },
    "calendar": { "type": "object", "required": ["dayStart", "dayEnd", "events"], "properties": { "events": { "type": "array", "items": { "type": "object", "required": ["id", "title", "start", "end", "kind", "note", "brief"], "properties": { "kind": { "enum": ["accepted", "customer", "optional", "block", "personal"] }, "brief": {"$ref": "#/$defs/brief"} } } } } },
    "risks": { "type": "array", "items": { "type": "object", "required": ["id", "status", "evidence", "account", "item", "owner", "age", "projectionDate", "projection", "verb", "action"] } },
    "risksNote": { "type": "string" },
    "inbox": { "type": "object", "required": ["reply", "fyi"], "properties": {
      "reply": { "type": "array", "items": { "type": "object", "required": ["id", "channel", "from", "subject", "quote", "action", "url"], "properties": { "channel": { "enum": ["email", "teams", "form"] }, "draftUrl": {"type": "string"} } } },
      "fyi": { "type": "array", "items": { "type": "object", "required": ["id", "channel", "from", "text", "url"], "properties": { "channel": { "enum": ["email", "teams"] } } } } } },
    "ledger": { "type": "array", "items": { "type": "object", "required": ["id", "status", "commitment", "owner", "due", "age", "evidence", "evidenceNote"], "properties": { "status": { "enum": ["overdue", "open", "waiting", "closed"] } } } },
    "hygiene": { "type": "array", "items": { "type": "object", "required": ["id", "day", "dayFlag", "event", "proposal", "why"] } },
    "team": { "type": "object", "required": ["mode", "quietAfterDays", "members"], "properties": { "mode": { "enum": ["directReports", "frequentContacts"] }, "members": { "type": "array", "items": { "type": "object", "required": ["id", "upn", "name", "role", "lastTouch", "lastOneToOne", "nextOneToOne", "waitingOnYou", "youWaitOn", "raiseNext", "signal", "daysSinceOneToOne"], "properties": { "signal": { "enum": ["blocked", "quiet", "nominal"] } } } } } },
    "people": { "type": "array", "items": { "type": "object", "required": ["id", "name", "role", "lastTouch", "waitingOnYou", "youWaitOn"] } },
    "weekInReview": { "type": "object", "properties": { "summary": {"type": "string"}, "series": { "type": "array", "items": { "type": "object", "required": ["name", "points"] } } } }
  }
}
